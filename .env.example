LINODE_TOKEN=replace_with_linode_api_token
ADMIN_TOKEN=replace_with_long_random_admin_token
DB_PATH=/data/manager.db
WP2_BASE_URL=https://api10.seox9.com\nWP2_API_TOKEN=\nWP2_NODES_PATH=\nWP2_AUTH_HEADER=Authorization\nWP2_AUTH_SCHEME=Bearer\nSSH_PRIVATE_KEY_PATH=/run/secrets/linode_ssh_key\nSSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts\n
# Monitoring and Telegram alerts (disabled until configured)
MONITOR_ENABLED=false
MONITOR_INTERVAL=60
MONITOR_SSH_USER=root
ALERT_FAILURE_COUNT=3
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
TG_BOT_TOKEN=
TG_CHAT_ID=
