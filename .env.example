LINODE_TOKEN=replace_with_linode_api_token
# Required for adding multiple accounts in the web UI (at least 32 random characters)
# Generate locally: openssl rand -hex 32
ACCOUNT_ENCRYPTION_KEY=
ACCOUNTS_FILE=/data/accounts.enc
ADMIN_TOKEN=replace_with_long_random_admin_token
# Required for public browser login; use a unique password of at least 12 characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set a DNS hostname pointing at this manager before enabling HTTPS public profile
PANEL_DOMAIN=panel.example.com
DB_PATH=/data/manager.db
WP2_BASE_URL=https://api10.seox9.com
WP2_API_TOKEN=
WP2_NODES_PATH=/mod_mu/nodes
WP2_AUTH_HEADER=Authorization
WP2_AUTH_SCHEME=Bearer
SSH_PRIVATE_KEY_PATH=/run/secrets/linode_ssh_key
SSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts

# Monitoring and Telegram alerts (disabled until configured)
MONITOR_ENABLED=false
MONITOR_INTERVAL=60
MONITOR_SSH_USER=root
ALERT_FAILURE_COUNT=3
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
TG_BOT_TOKEN=
TG_CHAT_ID=

# AES-GCM encrypted root passwords, using ACCOUNT_ENCRYPTION_KEY
INSTANCE_CREDENTIALS_FILE=/data/instance-credentials.enc
